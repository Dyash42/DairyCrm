// Jharanai CRM — database schema
// Run: npm run prisma:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (port 6543 on Supabase) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — required by Prisma Migrate to bypass PgBouncer.
  // On local/non-Supabase Postgres, set DIRECT_URL = DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Users (Admin / Executive)
// ============================================================

enum UserRole {
  ADMIN
  EXECUTIVE
}

model User {
  id           String   @id @default(cuid())
  role         UserRole
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Executive-specific
  executive Executive?
}

// ============================================================
// Routes & Executives
// ============================================================

model Route {
  id        String   @id @default(cuid())
  name      String   @unique
  area      String
  pinCodes  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  Customer[]
  executive  Executive?
  deliveries Delivery[]
  broadcasts BroadcastRoute[]
}

model Executive {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId   String?  @unique
  route     Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
}

// ============================================================
// Customers
// ============================================================

enum CustomerStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Customer {
  id           String         @id @default(cuid())
  code         String         @unique // human readable, e.g. JHR-100455
  name         String
  phone        String         @unique
  altPhone     String?
  email        String?
  addressLine1 String
  addressLine2 String?
  area         String?
  pinCode      String?
  routeId      String?
  route        Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeSeq     Int? // order within route
  status       CustomerStatus @default(ACTIVE)
  litresPerDay Decimal        @default(0) @db.Decimal(6, 2)
  balance      Decimal        @default(0) @db.Decimal(10, 2)
  qrCodeUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions    Subscription[]
  pauses           PauseRecord[]
  payments         Payment[]
  deliveries       Delivery[]
  whatsappLogs     WhatsAppLog[]
  renewalReminders RenewalReminder[]
  qrCodes          QrCode[]

  @@index([routeId, status])
  @@index([phone])
}

// ============================================================
// Subscriptions
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id           String             @id @default(cuid())
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Stable product reference. Optional for back-compat with sku strings.
  productId    String?
  product      Product?           @relation(fields: [productId], references: [id])
  /// Legacy SKU string — kept so older rows still resolve a name when
  /// product is null. New rows should always set productId.
  sku          String             @default("COW_MILK")
  litresPerDay Decimal            @db.Decimal(6, 2)
  daysOfWeek   Int[] // 0=Sun .. 6=Sat
  /// Cached rate at the time of subscription creation. Lets us replay a
  /// historical quote even if the Product's rate later changes.
  ratePerLitre Decimal            @db.Decimal(8, 2)
  startDate    DateTime
  endDate      DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  pauses           PauseRecord[]
  renewalReminders RenewalReminder[]

  @@index([customerId, status])
  @@index([productId])
}

model PauseRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  /// endDate + 1 day — what scheduling engine resumes on.
  resumeDate     DateTime
  /// When the "deliveries resume tomorrow" WhatsApp reminder went out.
  reminderSentAt DateTime?
  reason         String?
  createdAt      DateTime     @default(now())

  autoResumeJob AutoResumeJob?

  @@index([subscriptionId])
  @@index([startDate, endDate])
  @@index([resumeDate])
}

/// Queued auto-resume action that fires on resumeDate.
/// Lets us inspect, retry, and audit the lifecycle without polling.
enum AutoResumeStatus {
  PENDING
  REMINDED
  RESUMED
  FAILED
  CANCELLED
}

model AutoResumeJob {
  id            String           @id @default(cuid())
  pauseRecordId String           @unique
  pauseRecord   PauseRecord      @relation(fields: [pauseRecordId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  status        AutoResumeStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  remindedAt    DateTime?
  resumedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, scheduledFor])
}

/// Audit + metric source for PRD §9 "Subscription renewal rate".
enum RenewalReminderStatus {
  PENDING
  SENT
  RENEWED
  EXPIRED
  CANCELLED
}

model RenewalReminder {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// When the subscription is due to expire — drives when to send.
  dueDate        DateTime
  sentAt         DateTime?
  respondedAt    DateTime?
  status         RenewalReminderStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, dueDate])
  @@index([customerId])
}

/// Sellable product / SKU. Admin can add new ones (ghee, butter, paneer…)
/// and edit rates without code changes. Subscriptions reference Product by
/// id; legacy Subscription.sku string is kept for back-compat.
enum ProductCategory {
  MILK
  CURD
  GHEE
  BUTTER
  PANEER
  OTHER
}

model Product {
  id          String          @id @default(cuid())
  /// Stable upper-case code referenced by code (COW_MILK, GHEE_200ML).
  code        String          @unique
  name        String
  description String?
  category    ProductCategory @default(MILK)
  /// Price per `unit` in INR.
  ratePerUnit Decimal         @db.Decimal(10, 2)
  /// Unit string: 'L', 'kg', 'g', 'ml', 'pcs'.
  unit        String          @default("L")
  active      Boolean         @default(true)
  imageUrl    String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedBy   String?

  subscriptions Subscription[]

  @@index([active, sortOrder])
  @@index([category])
}

/// Generic key/value settings table — admin can edit any value from the
/// admin Settings page. Each setting has a group (for UI grouping), a
/// human-readable label, and an optional description. The `constants.ts`
/// values act as defaults when no row exists (fresh DB / dev).
enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Setting {
  /// Dotted key, e.g. 'subscription.default_duration_days'.
  key         String      @id
  /// JSON-stringified value (cast by SettingsService based on `type`).
  value       String
  type        SettingType
  /// UI grouping: 'subscription', 'pause', 'otp', 'delivery', etc.
  group       String
  label       String
  description String?
  /// false → setting is read-only in admin UI (managed by env).
  editable    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  updatedBy   String?

  @@index([group])
}

/// Atomic counter for human-readable customer codes (JHR-100455).
/// Single-row table — we always upsert the row with key 'customer'.
model CustomerCodeCounter {
  key       String   @id // 'customer' for now; future: 'invoice', etc.
  lastValue Int      @default(100454) // first issued code will be 100455
  updatedAt DateTime @updatedAt
}

/// Audit history of QR codes issued to a customer.
/// Lets admin revoke + regenerate when a QR is lost or misused; old rows
/// stay around forever so we can trace a scan back to the issued code.
enum QrCodeStatus {
  ACTIVE
  REVOKED
}

model QrCode {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The encoded payload — usually the customer code (JHR-XXXXXX). The same
  /// customer can have multiple rows over time (revoke + regenerate).
  payload     String
  /// Where the rendered PNG lives (data URL in dev, S3/R2 URL in prod).
  url         String
  status      QrCodeStatus @default(ACTIVE)
  version     Int          @default(1)
  generatedAt DateTime     @default(now())
  revokedAt   DateTime?
  revokedBy   String? // user id of admin who revoked
  reason      String? // why revoked (lost / abused / etc.)

  @@index([customerId, status])
  @@index([payload])
}

/// No-delivery days. The scheduling engine filters scheduledFor against this.
///
/// The unique constraint is composite (date + scope) so we can have:
///   - A platform-wide holiday on 26 Jan with scope='ALL'
///   - A route-specific holiday on the same day for one route
/// The previous schema had `date` uniquely indexed alone, which silently
/// overwrote the ALL row when an admin added a route-specific holiday.
model HolidayCalendar {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String
  scope     String   @default("ALL") // 'ALL' or route id (route-specific holiday)
  createdAt DateTime @default(now())

  @@unique([date, scope])
  @@index([scope, date])
}

// ============================================================
// Payments
// ============================================================

enum PaymentMode {
  CASH
  UPI_STATIC
  UPI_ONLINE
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  mode       PaymentMode
  status     PaymentStatus @default(PENDING)
  reference  String? // gateway ref or note
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([customerId, status])
}

// ============================================================
// Deliveries
// ============================================================

enum DeliveryStatus {
  PENDING
  DELIVERED
  PARTIAL
  SKIPPED
  MISSED
}

model Delivery {
  id              String         @id @default(cuid())
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  routeId         String
  route           Route          @relation(fields: [routeId], references: [id])
  executiveId     String?
  executive       Executive?     @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  scheduledLitres Decimal        @db.Decimal(6, 2)
  deliveredLitres Decimal?       @db.Decimal(6, 2)
  status          DeliveryStatus @default(PENDING)
  scheduledFor    DateTime
  scannedAt       DateTime?
  note            String?
  /// When the post-scan WhatsApp confirmation went out. NULL = not yet sent.
  /// Used by the delivery-confirm cron as a proper idempotency flag (replaces
  /// the old `[wa-sent]` marker that lived inside `note`).
  confirmationSentAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([customerId, scheduledFor])
  @@index([routeId, scheduledFor])
  @@index([executiveId, scheduledFor])
  @@index([scheduledFor, status])
  @@index([status, confirmationSentAt])
}

// ============================================================
// Broadcasts (WhatsApp updates to routes)
// ============================================================

enum BroadcastTarget {
  ALL
  ROUTES
  CUSTOMERS
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Broadcast {
  id             String          @id @default(cuid())
  message        String
  templateName   String?
  target         BroadcastTarget
  scheduledFor   DateTime?
  status         BroadcastStatus @default(DRAFT)
  sentCount      Int             @default(0)
  deliveredCount Int             @default(0)
  failedCount    Int             @default(0)
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  routes BroadcastRoute[]
}

model BroadcastRoute {
  broadcastId String
  routeId     String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([broadcastId, routeId])
}

// ============================================================
// WhatsApp message log (cost tracking + audit)
// ============================================================

enum WaDirection {
  INBOUND
  OUTBOUND
}

enum WaCategory {
  UTILITY
  AUTHENTICATION
  MARKETING
  SERVICE
}

model WhatsAppLog {
  id         String      @id @default(cuid())
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String
  direction  WaDirection
  templateId String?
  category   WaCategory?
  body       String?
  metaMsgId  String?
  status     String?
  costInr    Decimal?    @db.Decimal(8, 4)
  timestamp  DateTime    @default(now())

  @@index([customerId])
  @@index([phone, timestamp])
}
