# =====================================================================
# Jharanai backend — environment variables (copy to .env, fill, do NOT commit)
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Supabase) ---
# From Supabase dashboard → Project settings → Database → Connection string.
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL.
# Use the "Session" / direct URL (port 5432) for DIRECT_URL.
# Both must include ?pgbouncer=true and ?sslmode=require where applicable.
#
# Example:
# DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DATABASE_URL=
DIRECT_URL=

# --- Redis (sessions, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-in-production-32-chars-minimum"
JWT_EXPIRES_IN="7d"

# --- WhatsApp (Meta Cloud API – direct) ---
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0

# --- Storage (Cloudflare R2 / S3) ---
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- Observability ---
SENTRY_DSN=
