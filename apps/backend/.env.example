# =====================================================================
# Jharanai backend — environment variables (copy to .env, fill, do NOT commit)
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=3000
# IANA timezone for business operations. Drives "today", weekday math,
# and MON_TO_SAT subscription scheduling. Don't change unless you've
# physically moved the dairy.
BUSINESS_TZ=Asia/Kolkata
# CORS origin for the web admin (Next.js dev server defaults to :3001).
# REQUIRED (non-default) in production — the boot guard refuses localhost.
ADMIN_ORIGIN=http://localhost:3001
# Number of proxy hops in front of the app (load balancer / CDN). Bounds how
# much of X-Forwarded-For we trust for rate-limit keying. Set to the real hop
# count in production (usually 1) so clients can't spoof XFF to bypass limits.
TRUST_PROXY=1
# Public URL of THIS backend, e.g. https://api.jharanai.com. Used to build
# publicly-fetchable QR image URLs the WhatsApp Cloud API can load (Meta
# rejects data: URIs). Leave blank in dev (the stub provider doesn't fetch).
PUBLIC_BASE_URL=

# --- Database (Supabase) ---
# From Supabase dashboard → Project settings → Database → Connection string.
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL.
# Use the "Session" / direct URL (port 5432) for DIRECT_URL.
# Both must include ?pgbouncer=true and ?sslmode=require where applicable.
#
# Example:
# DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DATABASE_URL=
DIRECT_URL=

# --- Redis (BullMQ jobs + future OTP store) ---
# Without this, the worker falls back to in-process setInterval — fine
# for dev, not for multi-pod prod where you want a single scheduler.
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# REQUIRED in production. The boot guard refuses to start if this is
# either missing or the default 'dev-secret-...' value.
JWT_SECRET="change-me-in-production-32-chars-minimum"
JWT_EXPIRES_IN="7d"

# --- Payments (Razorpay or Cashfree; auto-detected by which keys are set) ---
# PAYMENT_PROVIDER overrides auto-detect. Set to 'stub' to disable real
# gateway integration entirely (useful in local dev).
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# --- Messaging (WhatsApp via Meta Cloud API) ---
# MESSAGING_PROVIDER=meta when creds below are set; 'stub' otherwise.
MESSAGING_PROVIDER=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
# Dev-only escape hatch — set to '1' to accept unsigned WhatsApp webhooks
# (e.g. when curling locally without a real Meta subscription). REFUSED in
# production regardless of this flag.
ALLOW_UNSIGNED_WEBHOOK=0

# --- SMS (executive OTP fallback when WhatsApp is unavailable) ---
# SMS_PROVIDER=console prints OTPs to stdout (default). Switch to
# msg91 or twilio when you have creds.
SMS_PROVIDER=console
# Static OTP pin — when no real SMS provider is wired, this pin logs in ANY
# registered, active executive (lets the field team work without SMS sends).
# Leave UNSET once SMS is configured: a fixed pin is a shared credential.
# 4–8 digits. A loud warning is logged at boot whenever it is set.
AUTH_STATIC_OTP=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Storage (Cloudflare R2 / S3) ---
# STORAGE_PROVIDER=local writes QR PNGs to ./data/storage; switch to s3 or r2 in prod.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# Public base URL when STORAGE_PROVIDER=local — used to render QR image URLs
# in admin UI without exposing internal file paths.
LOCAL_STORAGE_PUBLIC_BASE=

# --- Observability ---
SENTRY_DSN=
# 0.0–1.0 fraction of requests Sentry samples for performance traces.
# Default 0.1 (10%). Crank to 1.0 for the first day after deploy to
# debug, then back to 0.05 to stay within free-tier quota.
SENTRY_TRACES_SAMPLE_RATE=0.1
