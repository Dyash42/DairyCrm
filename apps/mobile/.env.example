# Base URL for the Jharanai backend REST API. No trailing slash.
# Read at build time via Expo's EXPO_PUBLIC_ env convention.
#
#   - Android emulator  -> http://10.0.2.2:3000   (host loopback)
#   - iOS simulator     -> http://localhost:3000
#   - Physical device   -> http://<your-LAN-ip>:3000  (same Wi-Fi)
#   - Staging / prod    -> https://api.jharanai.com
#
# Copy this file to `.env` and adjust. Expo inlines EXPO_PUBLIC_* at bundle time.
EXPO_PUBLIC_API_BASE=http://10.0.2.2:3000
